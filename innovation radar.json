{
  "$schema": "https://vega.github.io/schema/vega/v5.json",
  "width": 760,
  "height": 760,
  "padding": 5,
  "autosize": "pad",
  "signals": [
    {"name": "centerX", "update": "width / 2"},
    {"name": "centerY", "update": "height / 2"},
    {"name": "innerRadius", "value": 35},
    {"name": "dataOuterRadius", "value": 280},
    {"name": "stageRuleRadius", "value": 315},
    {"name": "topicRuleRadius", "value": 330},
    {"name": "stageLabelRadius", "value": 350},
    {"name": "topicLabelRadius", "value": 382},
    {"name": "overlapOffsetStep", "value": 14},
    {"name": "topicCount", "update": "max(length(data('topicOrder')), 1)"},
    {"name": "stageCount", "update": "max(length(data('stageOrder')), 1)"},
    {"name": "ringCount", "update": "max(length(data('trlOrder')), 1)"},
    {"name": "topicAngle", "update": "2 * PI / topicCount"},
    {"name": "slotAngle", "update": "topicAngle / stageCount"},
    {"name": "ringStep", "update": "ringCount > 1 ? (dataOuterRadius - innerRadius) / (ringCount - 1) : 0"},
    {"name": "topicLabelFontSize", "update": "clamp(13 - topicCount / 3, 8, 11)"},
    {"name": "stageLabelFontSize", "update": "clamp(12 - topicCount * stageCount / 15, 6, 8)"}
  ],
  "data": [
    {"name": "dataset"},
    {
      "name": "topicOrder",
      "source": "dataset",
      "transform": [
        {"type": "filter", "expr": "isValid(datum['Topic']) && datum['Topic'] !== ''"},
        {"type": "window", "ops": ["row_number"], "as": ["rowOrder"]},
        {"type": "aggregate", "groupby": ["Topic"], "fields": ["rowOrder"], "ops": ["min"], "as": ["firstRow"]},
        {"type": "collect", "sort": {"field": "firstRow", "order": "ascending"}},
        {"type": "window", "ops": ["row_number"], "as": ["topicNumber"]},
        {"type": "formula", "expr": "datum.topicNumber - 1", "as": "topicIndex"}
      ]
    },
    {
      "name": "stageOrder",
      "source": "dataset",
      "transform": [
        {"type": "filter", "expr": "isValid(datum['Internal Stage']) && datum['Internal Stage'] !== ''"},
        {"type": "formula", "expr": "toNumber(split(datum['Internal Stage'], ' ')[0])", "as": "StageNum"},
        {"type": "aggregate", "groupby": ["Internal Stage", "StageNum"], "ops": ["count"], "as": ["rowCount"]},
        {"type": "collect", "sort": {"field": "StageNum", "order": "ascending"}},
        {"type": "window", "ops": ["row_number"], "as": ["stageNumber"]},
        {"type": "formula", "expr": "datum.stageNumber - 1", "as": "stageIndex"},
        {"type": "formula", "expr": "replace(datum['Internal Stage'], ' - ', '\\n')", "as": "displayLabel"}
      ]
    },
    {
      "name": "trlOrder",
      "source": "dataset",
      "transform": [
        {"type": "filter", "expr": "isValid(datum['TRL level']) && datum['TRL level'] !== ''"},
        {"type": "formula", "expr": "toNumber(split(datum['TRL level'], ' ')[0])", "as": "TrlNum"},
        {"type": "aggregate", "groupby": ["TRL level", "TrlNum"], "ops": ["count"], "as": ["rowCount"]},
        {"type": "collect", "sort": {"field": "TrlNum", "order": "ascending"}},
        {"type": "window", "ops": ["row_number"], "as": ["trlNumber"]},
        {"type": "formula", "expr": "datum.trlNumber - 1", "as": "trlIndex"}
      ]
    },
    {
      "name": "topicSeparators",
      "source": "topicOrder",
      "transform": [
        {"type": "formula", "expr": "(datum.topicIndex + 1) * topicAngle - PI / 2", "as": "angle"},
        {"type": "formula", "expr": "centerX + topicRuleRadius * cos(datum.angle)", "as": "x2"},
        {"type": "formula", "expr": "centerY + topicRuleRadius * sin(datum.angle)", "as": "y2"}
      ]
    },
    {
      "name": "topicLabels",
      "source": "topicOrder",
      "transform": [
        {"type": "formula", "expr": "(datum.topicIndex + 0.5) * topicAngle - PI / 2", "as": "angle"},
        {"type": "formula", "expr": "centerX + topicLabelRadius * cos(datum.angle)", "as": "x"},
        {"type": "formula", "expr": "centerY + topicLabelRadius * sin(datum.angle)", "as": "y"}
      ]
    },
    {
      "name": "stageGrid",
      "transform": [
        {"type": "sequence", "start": 0, "stop": {"signal": "topicCount * stageCount"}, "as": "slot"},
        {"type": "formula", "expr": "floor(datum.slot / stageCount)", "as": "topicIndex"},
        {"type": "formula", "expr": "datum.slot % stageCount", "as": "stageIndex"},
        {"type": "lookup", "from": "topicOrder", "key": "topicIndex", "fields": ["topicIndex"], "values": ["Topic"], "as": ["Topic"]},
        {
          "type": "lookup",
          "from": "stageOrder",
          "key": "stageIndex",
          "fields": ["stageIndex"],
          "values": ["Internal Stage", "displayLabel", "stageNumber"],
          "as": ["StageLabel", "displayLabel", "stageNumber"]
        },
        {"type": "formula", "expr": "datum.topicIndex * topicAngle + (stageCount - datum.stageIndex - 0.5) * slotAngle - PI / 2", "as": "angle"},
        {"type": "formula", "expr": "stageLabelRadius + (datum.stageIndex % 2) * 14", "as": "labelRadius"},
        {"type": "formula", "expr": "centerX + datum.labelRadius * cos(datum.angle)", "as": "x"},
        {"type": "formula", "expr": "centerY + datum.labelRadius * sin(datum.angle)", "as": "y"},
        {"type": "formula", "expr": "datum.angle * 180 / PI + 90", "as": "rawAngle"},
        {"type": "formula", "expr": "datum.rawAngle > 90 && datum.rawAngle < 270 ? datum.rawAngle + 180 : datum.rawAngle", "as": "textAngle"},
        {"type": "formula", "expr": "datum.rawAngle > 90 && datum.rawAngle < 270 ? 'right' : 'left'", "as": "textAlign"},
        {"type": "formula", "expr": "datum.topicIndex * topicAngle + datum.stageNumber * slotAngle - PI / 2", "as": "separatorAngle"},
        {"type": "formula", "expr": "centerX + stageRuleRadius * cos(datum.separatorAngle)", "as": "separatorX2"},
        {"type": "formula", "expr": "centerY + stageRuleRadius * sin(datum.separatorAngle)", "as": "separatorY2"}
      ]
    },
    {
      "name": "stageSeparators",
      "source": "stageGrid",
      "transform": [
        {"type": "filter", "expr": "datum.stageIndex < stageCount - 1"}
      ]
    },
    {
      "name": "points",
      "source": "dataset",
      "transform": [
        {
          "type": "filter",
          "expr": "isValid(datum['Topic']) && datum['Topic'] !== '' && isValid(datum['Internal Stage']) && datum['Internal Stage'] !== '' && isValid(datum['TRL level']) && datum['TRL level'] !== ''"
        },
        {"type": "lookup", "from": "topicOrder", "key": "Topic", "fields": ["Topic"], "values": ["topicIndex"], "as": ["TopicIndex"]},
        {"type": "lookup", "from": "stageOrder", "key": "Internal Stage", "fields": ["Internal Stage"], "values": ["stageIndex"], "as": ["StageIndex"]},
        {"type": "lookup", "from": "trlOrder", "key": "TRL level", "fields": ["TRL level"], "values": ["trlIndex"], "as": ["TrlIndex"]},
        {"type": "filter", "expr": "isValid(datum.TopicIndex) && isValid(datum.StageIndex) && isValid(datum.TrlIndex)"},
        {"type": "joinaggregate", "groupby": ["TopicIndex", "StageIndex", "TrlIndex"], "ops": ["count"], "as": ["overlapCount"]},
        {
          "type": "collect",
          "sort": {
            "field": ["TopicIndex", "StageIndex", "TrlIndex", "Supplier", "Technique/product"],
            "order": ["ascending", "ascending", "ascending", "ascending", "ascending"]
          }
        },
        {"type": "window", "groupby": ["TopicIndex", "StageIndex", "TrlIndex"], "ops": ["row_number"], "as": ["overlapIndex"]},
        {"type": "formula", "expr": "datum.TopicIndex * topicAngle + (stageCount - datum.StageIndex - 0.5) * slotAngle - PI / 2", "as": "angle"},
        {"type": "formula", "expr": "ringCount > 1 ? innerRadius + datum.TrlIndex * ringStep : dataOuterRadius", "as": "radius"},
        {"type": "formula", "expr": "(datum.overlapIndex - (datum.overlapCount + 1) / 2) * overlapOffsetStep", "as": "overlapOffset"},
        {"type": "formula", "expr": "centerX + datum.radius * cos(datum.angle) + datum.overlapOffset * cos(datum.angle + PI / 2)", "as": "x"},
        {"type": "formula", "expr": "centerY + datum.radius * sin(datum.angle) + datum.overlapOffset * sin(datum.angle + PI / 2)", "as": "y"}
      ]
    }
  ],
  "scales": [
    {
      "name": "mediumColor",
      "type": "ordinal",
      "domain": {"data": "points", "field": "Medium"},
      "range": {"scheme": "tableau10"}
    }
  ],
  "legends": [
    {"fill": "mediumColor", "title": "Medium", "orient": "right"}
  ],
  "marks": [
    {
      "type": "arc",
      "from": {"data": "trlOrder"},
      "encode": {
        "update": {
          "x": {"signal": "centerX"},
          "y": {"signal": "centerY"},
          "startAngle": {"value": 0},
          "endAngle": {"signal": "2 * PI"},
          "innerRadius": {"signal": "max((ringCount > 1 ? innerRadius + datum.trlIndex * ringStep : dataOuterRadius) - 0.5, 0)"},
          "outerRadius": {"signal": "(ringCount > 1 ? innerRadius + datum.trlIndex * ringStep : dataOuterRadius) + 0.5"},
          "stroke": {"value": "#D0D0D0"},
          "strokeWidth": {"value": 1},
          "fillOpacity": {"value": 0}
        }
      }
    },
    {
      "type": "rule",
      "from": {"data": "stageSeparators"},
      "encode": {
        "update": {
          "x": {"signal": "centerX"},
          "y": {"signal": "centerY"},
          "x2": {"field": "separatorX2"},
          "y2": {"field": "separatorY2"},
          "stroke": {"value": "#D8D8D8"},
          "strokeWidth": {"value": 1},
          "strokeDash": {"value": [4, 4]}
        }
      }
    },
    {
      "type": "rule",
      "from": {"data": "topicSeparators"},
      "encode": {
        "update": {
          "x": {"signal": "centerX"},
          "y": {"signal": "centerY"},
          "x2": {"field": "x2"},
          "y2": {"field": "y2"},
          "stroke": {"value": "#888888"},
          "strokeWidth": {"value": 1}
        }
      }
    },
    {
      "type": "symbol",
      "from": {"data": "points"},
      "encode": {
        "update": {
          "x": {"field": "x"},
          "y": {"field": "y"},
          "size": {"value": 180},
          "shape": {"value": "circle"},
          "fill": {"scale": "mediumColor", "field": "Medium"},
          "stroke": {"value": "white"},
          "strokeWidth": {"value": 1.5},
          "tooltip": {
            "signal": "{'Supplier': datum['Supplier'], 'Technique / Product': datum['Technique/product'], 'Description': datum['Description'], 'Responsible': datum['Responsible'], 'Type': datum['Type'], 'Contaminant': datum['Contaminant'], 'Medium': datum['Medium'], 'Topic': datum['Topic'], 'TRL': datum['TRL level'], 'Internal Stage': datum['Internal Stage']}"
          }
        }
      }
    },
    {
      "type": "text",
      "from": {"data": "topicLabels"},
      "encode": {
        "update": {
          "x": {"field": "x"},
          "y": {"field": "y"},
          "text": {"field": "Topic"},
          "align": {"value": "center"},
          "baseline": {"value": "middle"},
          "fontWeight": {"value": "bold"},
          "fontSize": {"signal": "topicLabelFontSize"},
          "fill": {"value": "#111111"}
        }
      }
    },
    {
      "type": "text",
      "from": {"data": "stageGrid"},
      "encode": {
        "update": {
          "x": {"field": "x"},
          "y": {"field": "y"},
          "text": {"field": "displayLabel"},
          "angle": {"field": "textAngle"},
          "align": {"field": "textAlign"},
          "baseline": {"value": "middle"},
          "fontSize": {"signal": "stageLabelFontSize"},
          "lineHeight": {"signal": "stageLabelFontSize + 1"},
          "fill": {"value": "#777777"}
        }
      }
    }
  ],
  "config": {
    "view": {
      "stroke": null
    }
  }
}
